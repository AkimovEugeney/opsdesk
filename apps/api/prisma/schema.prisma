datasource db {
    provider = "postgresql"
}

generator client {
    provider     = "prisma-client"
    output       = "../src/generated/prisma"
    moduleFormat = "cjs"
}

enum UserRole {
    OPERATOR
    CLIENT
}

enum AppealStatus {
    NEW
    IN_PROGRESS
    CLOSED
}

enum Permissions {
    CAN_MANAGE_APPEALS
}

model User {
    id           Int      @id @default(autoincrement())
    name         String
    role         UserRole
    email        String   @unique
    passwordHash String
    createdAt    DateTime @default(now())
    permissions Permissions[] @default([])

    clientAppeals Appeal[]  @relation("AppealClient")
    ownerAppeals  Appeal[]  @relation("AppealOwner")
    sessions      Session[]
    appealUpdateMessages AppealUpdateMessage[]
}

model Appeal {
    id          Int          @id @default(autoincrement())
    status      AppealStatus
    title       String
    description String
    client      User         @relation("AppealClient", fields: [clientId], references: [id])
    clientId    Int
    outcome     String?
    createdAt   DateTime     @default(now())
    updatedAt   DateTime     @updatedAt
    closedAt    DateTime?
    ownerId     Int?
    owner       User?        @relation("AppealOwner", fields: [ownerId], references: [id])
    appealUpdateMessages AppealUpdateMessage[]
}

model AppealUpdateMessage {
    id Int @id @default(autoincrement())
    message String
    createdAt DateTime @default(now())
    appealId Int
    appeal Appeal @relation(fields: [appealId], references: [id])
    authorId Int
    author User @relation(fields: [authorId], references: [id])
}

model Session {
    id             String   @id
    createdAt      DateTime @default(now())
    lastActivityAt DateTime
    userId         Int
    user           User     @relation(fields: [userId], references: [id])
}

