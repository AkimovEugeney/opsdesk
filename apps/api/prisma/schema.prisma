datasource db {
    provider = "postgresql"
}

generator client {
    provider     = "prisma-client"
    output       = "../src/generated/prisma"
    moduleFormat = "cjs"
}

enum UserRole {
    OPERATOR
    CLIENT
}

enum AppealStatus {
    NEW
    IN_PROGRESS
    CLOSED
}

model User {
    id        Int      @id @default(autoincrement())
    name      String
    role      UserRole
    createdAt DateTime @default(now())

    clientAppeals Appeal[] @relation("AppealClient")
    ownedAppeals  Appeal[] @relation("AppealOwner")
}

model Appeal {
    id          Int          @id @default(autoincrement())
    status      AppealStatus
    title       String
    description String
    client      User         @relation("AppealClient", fields: [clientId], references: [id])
    clientId    Int
    createdAt   DateTime     @default(now())
    updatedAt   DateTime     @updatedAt
    closedAt    DateTime?
    ownerId     Int?
    owner       User?         @relation("AppealOwner", fields: [ownerId], references: [id])
}
